    "express": "5.2.1",
    "helmet": "8.3.0",
    "swagger-ui-express": "5.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "supertest": "7.2.2",
    "vitest": "5.0.1"
  }
