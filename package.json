{
  "name": "desafio-final-arquiteto-software-api",
  "version": "1.0.0",
  "description": "API REST de Produtos em JavaScript, estruturada em MVC para o Desafio Final de Arquitetura de Software.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
